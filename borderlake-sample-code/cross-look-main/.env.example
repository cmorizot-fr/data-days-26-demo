# ==============================================================================
# Cross-Look — Cross-Cloud Lakehouse Demo Configuration (.env.example)
# Optional: ./deploy.sh automatically extracts parameters from your active
# `gcloud` and `aws` CLI configs, displays them for confirmation (letting you
# confirm or enter another existing GCP project ID), and writes `.env` for you.
# Copy to `.env` beforehand only if you want custom resource names:
#   cp .env.example .env
# ==============================================================================

# Existing Google Cloud Project ID. Leave empty to auto-detect from
# `gcloud config get-value project` (or enter interactively in ./deploy.sh).
GCP_PROJECT=""

# Co-located AWS <-> Google Cloud region pairs (auto-paired from `aws configure get region`
# when it matches one of the 4 supported Lakehouse regions, else defaults to us-east-1 <-> us-east4):
#   AWS us-east-1    <-> GCP us-east4     (Northern Virginia - Default)
#   AWS us-west-2    <-> GCP us-west1     (Oregon)
#   AWS eu-central-1 <-> GCP europe-west3 (Frankfurt)
#   AWS eu-west-2    <-> GCP europe-west2 (London)
AWS_REGION="us-east-1"
GCP_REGION="us-east4"

# Amazon S3 bucket name for raw staged Parquet + managed Apache Iceberg tables.
# Leave empty to use a deterministic globally-unique bucket per AWS account:
#   thelook-lakehouse-<aws_account_id>-<aws_region>
S3_BUCKET=""

# AWS Glue Data Catalog database & Athena workgroup
# (Also exposed as the 3rd-part SQL namespace: <project>.<catalog>.thelook_ecommerce.<table>)
GLUE_DB="thelook_ecommerce"
ATHENA_WORKGROUP="primary"

# Least-privilege AWS IAM role assumed by the Lakehouse service agent via OIDC
AWS_ROLE_NAME="gcp_lakehouse_glue_federation_role"

# Neutral Lakehouse runtime catalog name (no 'aws_glue' in the identifier, so queries
# hit <project>.thelook_catalog.thelook_ecommerce.<table> directly)
# & companion BigQuery dataset hosting the zero-copy ISO GQL Property Graph
FEDERATED_CATALOG="thelook_catalog"
BQ_DEMO_DATASET="thelook_commerce"

# Public BigQuery source dataset (US multi-region)
SOURCE_BQ_PROJECT="bigquery-public-data"
SOURCE_BQ_DATASET="thelook_ecommerce"
