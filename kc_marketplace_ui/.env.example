# Knowledge Catalog Business UI — Template d'environnement local
VITE_API_URL="http://localhost:3000/api"
VITE_API_VERSION="v1"
VITE_ADMIN_EMAIL="admin@example.com"
VITE_GOOGLE_PROJECT_ID="data-days-demo"
# Optionnel en local si VITE_ENABLE_LOCAL_GCLOUD_AUTH="true" (utilise votre session gcloud / ADC)
VITE_GOOGLE_CLIENT_ID=""
VITE_GOOGLE_REDIRECT_URI="http://localhost:5174"
VITE_IS_SERVICE_ACCOUNT="true"
VITE_ENABLE_LOCAL_GCLOUD_AUTH="true"
VITE_FEATURE_REQUEST_ACCESS="false"
