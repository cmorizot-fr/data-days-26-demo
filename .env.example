# ==============================================================================
# Paris Data Summit 2026 — Configuration d'environnement (exemple)
# Copier vers .env et renseigner les valeurs cibles avant exécution.
# ==============================================================================

# --- Google Cloud Platform ---
GCP_PROJECT_ID=data-days-demo
GCP_REGION=europe-west1
BQ_LOCATION=europe-west1

# --- Datasets BigQuery ---
BQ_DATASET_RAW=raw_bank
BQ_DATASET_SILVER=silver_bank
BQ_DATASET_GOLD=gold_bank

# --- Cloud Storage (Landing & Contrats PDF) ---
GCS_BUCKET_LANDING=data-days-demo-landing
GCS_BUCKET_PDF_CONTRACTS=data-days-demo-landing

# --- AWS Borderless Lakehouse (BigQuery Omni) ---
AWS_REGION=eu-west-1
AWS_S3_BUCKET_CRM=your-aws-crm-iceberg-bucket
AWS_GLUE_DATABASE=crm_callcenter_db
BQ_OMNI_CONNECTION_ID=aws-eu-west-1-crm-conn

# --- AlloyDB (Démo #4 — Passage à l'échelle mobile) ---
ALLOYDB_CLUSTER=bank-digital-cluster
ALLOYDB_INSTANCE=bank-digital-primary
ALLOYDB_DATABASE=mobile_bank

# --- Générateur de données (invariants déterministes) ---
DEMO_SEED=2026
DEMO_BANK_NAME=Banque Hexagone
DEMO_BANK_BIC=HEXAFRLPXXX
